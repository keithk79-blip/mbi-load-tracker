{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keith's Load Tracker",
  "version": "1.0.0",
  "identifier": "com.chitrader.loadtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4521",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keith's Load Tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Keith Lawson",
    "shortDescription": "Log and review transfer-station loads",
    "longDescription": "Keith's Load Tracker — truck, pickup, commodity, and destination. Not dispatch software.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
