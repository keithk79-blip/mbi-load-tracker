{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Load Tracker window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.sigalert.com/**" },
        { "url": "https://cdn-dynamic.sigalert.com/**" },
        { "url": "https://cdn.sigalert.com/**" },
        { "url": "https://*.supabase.co/**" },
        { "url": "https://*.supabase.in/**" },
        { "url": "https://docs.google.com/**" },
        { "url": "https://spreadsheets.google.com/**" }
      ]
    }
  ]
}
